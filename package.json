{
  "name": "facial",
  "version": "1.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dist": "node scripts/dist.js",
    "xpe:test": "node xpeAutomation/test.js",
    "xpe:install-browser": "npx playwright install chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Controle de acesso às piscinas do clube (desktop, offline-first)",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "playwright": "^1.62.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "electron": "^41.4.0",
    "electron-builder": "^26.15.3",
    "electron-reloader": "^1.2.3"
  },
  "build": {
    "appId": "com.aquaaccess.facial",
    "productName": "AquaAccess Facial",
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "xpeBridge.js",
      "xpeSetup.js",
      "xpeAutomation/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
